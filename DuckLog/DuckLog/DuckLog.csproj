<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationId>com.companyname.DuckLog</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<TrimMode Condition="'$(Configuration)' == 'Debug'">none</TrimMode>
		<TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>
		<StackTraceSupport>true</StackTraceSupport>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	</PropertyGroup>

	<ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
		<Compile Remove="AddModuleActivity.cs" />
		<Compile Remove="ModuleActvity.cs" />
		<Compile Remove="MainActivity.cs" />
		<Compile Remove="AddTaskActivity.cs" />
		<Compile Remove="EditTaskActivity.cs" />
		<Compile Remove="TaskActivity.cs" />
		<Compile Remove="AddUserActivity.cs" />
		<Compile Remove="ConnectionActivity.cs" />
		<Compile Remove="Notifications/AlarmScheduler.cs" />
		<Compile Remove="Notifications/DeadlineCheckReceiver.cs" />
		<Compile Remove="Notifications/NotificationHelper.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Dapper" Version="2.1.72" />
		<PackageReference Include="MySqlConnector" Version="2.5.0" />
	</ItemGroup>
</Project>