<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="120dp"
             android:layout_marginTop="16dp"
             android:elevation="2dp">

    <!-- BACKGROUND ROUGE POUR DELETE -->
    <LinearLayout
            android:id="@+id/deleteBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/primary_red"
            android:gravity="end|center_vertical"
            android:paddingEnd="20dp"
            android:visibility="gone"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/trash_delete_task"
                android:contentDescription="Delete task"
                android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- CONTENU DE LA CARTE (TON ANCIEN LAYOUT) -->
    <LinearLayout
            android:id="@+id/taskCardContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:orientation="vertical"
            android:background="@android:color/transparent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/txtTaskName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_title"
                        android:textColor="@color/primary_grey"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                <TextView
                        android:id="@+id/txtTaskStatus"
                        android:padding="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_task_status"
                        android:textColor="@color/primary_grey" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                <TextView
                        android:id="@+id/txtTaskStart"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_task_start"
                        android:textColor="@color/primary_grey" />

                <TextView
                        android:id="@+id/txtTaskEnd"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_task_end"
                        android:textColor="@color/primary_grey" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
