<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="120dp"
              android:layout_marginTop="16dp"
              android:background="@drawable/bg_module"
              android:padding="20dp"
              android:elevation="2dp"
              android:orientation="vertical">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/txtTaskName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_title"
                    android:textColor="@color/primary_grey"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            <TextView
                    android:id="@+id/txtTaskStatus"
                    android:padding="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_task_status"
                    android:textColor="@color/primary_grey" />

        </LinearLayout>
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
            <TextView
                    android:id="@+id/txtTaskStart"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_task_start"
                    android:textColor="@color/primary_grey" />
            <TextView
                    android:id="@+id/txtTaskEnd"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_task_end"
                    android:textColor="@color/primary_grey" />



        </LinearLayout>



    </LinearLayout>

</LinearLayout>