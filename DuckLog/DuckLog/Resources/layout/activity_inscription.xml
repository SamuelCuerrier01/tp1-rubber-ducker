<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">
    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/primary_yellow"
            android:elevation="4dp">
        <ImageButton
                android:id="@+id/btnReturn"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:contentDescription="to return to home menu"
                android:layout_alignParentStart="true"
                android:background="?android:attr/selectableItemBackground"
                android:tint="@color/primary_grey"
                android:src="@android:drawable/ic_menu_revert" />
        <TextView
                android:id="@+id/taskHeaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/title_inscription"
                android:textColor="@color/primary_grey"
                android:textSize="20sp"
                android:textStyle="bold" />
    </RelativeLayout>

    <Space
            android:layout_width="match_parent"
            android:layout_height="150dp"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_nom"
            android:textSize="20sp"
            android:textStyle="bold"/>
    <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/nom"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/email_title"
            android:textSize="20sp"
            android:textStyle="bold"/>
    <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/email_fieldt"/>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_motDePasse"
            android:textSize="20sp"
            android:textStyle="bold"/>
    <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/mot_de_passe"/>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/motDePasse_confirmation"
            android:textSize="20sp"
            android:textStyle="bold"/>
    <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/mot_de_passe_confirmation"/>
    <Button
            android:text="@string/inscription_button"
            android:layout_width="300px"
            android:layout_gravity="center_horizontal"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary_orange"
            android:layout_height="48dp" android:id="@+id/inscription_button"/>
    <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

</LinearLayout>