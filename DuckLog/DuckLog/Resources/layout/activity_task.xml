<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/primary_yellow"
            android:elevation="4dp">
        <ImageButton
                android:id="@+id/btnReturn"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:contentDescription="to return to home menu"
                android:layout_alignParentStart="true"
                android:background="?android:attr/selectableItemBackground"
                android:tint="@color/primary_grey"
                android:src="@android:drawable/ic_menu_revert" />
        <TextView
                android:id="@+id/taskHeaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/task_page_header"
                android:textColor="@color/primary_grey"
                android:textSize="20sp"
                android:textStyle="bold" />
        <ImageButton
                android:id="@+id/btnGenerate"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:contentDescription="generate"
                android:layout_alignParentEnd="true"
                android:background="@null"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/generate_btn" android:layout_marginEnd="0dp"/>
    </RelativeLayout>

    <LinearLayout
            android:id="@+id/taskListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

        <RelativeLayout
                android:id="@+id/btnAddTaskArea"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_module_add_area_rounded_border"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="add new task"
                    android:layout_centerInParent="true"
                    android:src="@android:drawable/ic_input_add"
                    android:tint="@color/primary_red" />

        </RelativeLayout>

    </LinearLayout>
</LinearLayout>