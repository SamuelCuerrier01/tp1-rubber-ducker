<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginTop="16dp"
    android:elevation="2dp">
    
    <LinearLayout
        android:id="@+id/deleteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_red"
        android:gravity="end|center_vertical"
        android:paddingEnd="20dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/trash_delete_task"
                android:contentDescription="Delete module"
                android:scaleType="fitCenter" />
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/moduleCardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_module"
        android:padding="20dp"
        android:orientation="vertical"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/txtModuleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Module Title"
            android:textColor="@color/primary_grey"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/txtTotalTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks: 0"
                android:textColor="@color/primary_grey"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progress_bar_horizontal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"       
                android:minHeight="24dp"           
                android:maxHeight="24dp"           
                android:max="100"
                android:progress="10"
                android:progressDrawable="@drawable/progress_bar_coloring" />
            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
